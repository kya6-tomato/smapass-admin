# GoバックエンドのURL（サーバー側でだけ使う。NEXT_PUBLIC_ を付けない）
GO_API_BASE_URL=http://localhost:8080
# true ならGoの代わりにモックを使う（モックのデモアカウント：demo-repair / demo-password）
USE_API_MOCK=true
# ログインCookieの名前
SESSION_COOKIE_NAME=partner_session
# 状態の問い合わせ間隔と上限（ミリ秒）。未設定なら 3000 / 120000
# POLL_INTERVAL_MS=3000
# POLL_TIMEOUT_MS=120000
